# ---- Runtime ----
NODE_ENV=development
PORT=3001

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000

# ---- Cookies ----
# 'lax' (default) for same-site; use 'none' (requires HTTPS/secure) for a
# cross-origin frontend. Allowed: lax | strict | none.
COOKIE_SAMESITE=lax

# ---- Database (Prisma / PostgreSQL) ----
# Running on the host machine against Docker Postgres: host "localhost", port 5433
# (compose maps host 5433 -> container 5432 to avoid clashing with a native Postgres).
# Inside the Docker network (compose `backend` service): use "postgres:5432".
DATABASE_URL="postgresql://electro:electro@localhost:5433/electro_pi?schema=public"

# ---- Auth (REQUIRED — boot fails if unset; no insecure fallback) ----
# Generate a strong value per secret, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# bcrypt work factor (optional, default 12). Lower in tests for speed.
BCRYPT_ROUNDS=12

# ---- Storage: Cloudinary (active StorageProvider for product image uploads) ----
# Required when creating/updating a product with an image file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payment: Stripe (placeholders — no implementation yet) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Mail: Resend (placeholder — no implementation yet) ----
RESEND_API_KEY=
