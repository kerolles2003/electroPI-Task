# ---- Runtime ----
NODE_ENV=development
PORT=3001

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000

# ---- Database (Prisma / PostgreSQL) ----
# Running on the host machine against Docker Postgres: host "localhost", port 5433
# (compose maps host 5433 -> container 5432 to avoid clashing with a native Postgres).
# Inside the Docker network (compose `backend` service): use "postgres:5432".
DATABASE_URL="postgresql://electro:electro@localhost:5433/electro_pi?schema=public"

# ---- Auth (placeholders — implementation deferred to a later phase) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Storage: Cloudinary (placeholders — no implementation yet) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payment: Stripe (placeholders — no implementation yet) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Mail: Resend (placeholder — no implementation yet) ----
RESEND_API_KEY=
