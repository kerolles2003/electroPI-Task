# ---- Runtime ----
NODE_ENV=development
PORT=3001

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000

# ---- Cookies ----
# 'lax' (default) for same-site; use 'none' (requires HTTPS/secure) for a
# cross-origin frontend. Allowed: lax | strict | none.
COOKIE_SAMESITE=lax

# ---- Database (Prisma / PostgreSQL) ----
# Running on the host machine against Docker Postgres: host "localhost", port 5433
# (compose maps host 5433 -> container 5432 to avoid clashing with a native Postgres).
# Inside the Docker network (compose `backend` service): use "postgres:5432".
DATABASE_URL="

# ---- Auth (REQUIRED — boot fails if unset; no insecure fallback) ----
# Generate a strong value per secret, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes (optional). Accepts ms-style strings: 15m, 1h, 7d.
# NOTE: if you raise JWT_ACCESS_TTL, also match ACCESS_TTL_MS (cookie maxAge) in src/config/configuration.ts.
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=7d
# bcrypt work factor (optional, default 12). Lower in tests for speed.
BCRYPT_ROUNDS=12

# ---- Storage: Cloudinary (active StorageProvider for product image uploads) ----
# Required when creating/updating a product with an image file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payment: Stripe (active online PaymentProvider) ----
# Required for ONLINE checkout (session creation) and webhook verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional — default to FRONTEND_URL + /checkout/success|cancel.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# ---- Mail: Provider selection ----
# Allowed: resend | brevo | local (default: local — logs to console, no network calls).
# In production, the active provider's credentials below must be set or boot fails.
MAIL_PROVIDER=local

# ---- Mail: Resend ----
# Required when MAIL_PROVIDER=resend (mandatory in production).
RESEND_API_KEY=
# Sender address — must be a verified domain in your Resend account.
MAIL_FROM=noreply@electro-pi.com

# ---- Mail: Brevo ----
# Required when MAIL_PROVIDER=brevo (mandatory in production).
BREVO_API_KEY=
BREVO_SENDER_NAME=electro-PI
BREVO_SENDER_EMAIL=noreply@electro-pi.com
